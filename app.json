{
  "expo": {
    "name": "Kidoro",
    "slug": "Kidoro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF002D"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF002D"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Kidoro"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "YouTubeIcon",
            "ios": "./assets/icon-youtube.png",
            "android": {
              "foregroundImage": "./assets/adaptive-icon-youtube.png",
              "backgroundColor": "#FFFFFF"
            }
          }
        ]
      ]
    ]
  }
}
